{
  "name": "ai-chat-exporter",
  "displayName": "__MSG_extensionName__",
  "version": "1.5.0",
  "description": "__MSG_extensionDescription__",
  "author": "pinguarmy",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/generate-i18n-chunks.mjs",
    "dev": "wxt",
    "i18n:generate": "node scripts/generate-i18n-chunks.mjs",
    "i18n:check": "node scripts/generate-i18n-chunks.mjs --check",
    "build": "bash scripts/build-all.sh",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "node scripts/extension-smoke.mjs && node scripts/scheduled-download-smoke.mjs && node scripts/ux-experience-smoke.mjs && node scripts/pdf-multilingual-regression.mjs",
    "test:browser:parallel": "node scripts/run-browser-smoke.mjs",
    "test:services": "node --test services/feedback/backend.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint:eslint": "eslint .",
    "lint:firefox": "node scripts/lint-firefox.mjs",
    "lint": "npm run typecheck && npm run typecheck:tests && npm run lint:eslint && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish:cws": "node scripts/publish-cws.mjs",
    "auth:cws": "node scripts/get-cws-token.mjs",
    "check:cws": "node scripts/publish-cws.mjs --check-auth",
    "sync:cws": "node scripts/sync-cws-secrets.mjs",
    "configure:publishing": "node scripts/configure-publishing.mjs",
    "check:publishing": "node scripts/check-publishing-config.mjs",
    "sync:publishing": "node scripts/sync-cws-secrets.mjs --all",
    "publish:firefox": "node scripts/publish-firefox.mjs",
    "publish:edge": "node scripts/publish-edge.mjs",
    "publish:all": "node scripts/publish-all.mjs",
    "canary:providers": "node scripts/provider-canary.mjs",
    "fixtures:capture": "node scripts/capture-provider-fixture.mjs",
    "fixtures:sanitize": "node scripts/sanitize-provider-fixture.mjs",
    "postinstall": "patch-package && wxt prepare",
    "dev:firefox": "wxt -b firefox"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "fflate": "0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^5.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "manifest": {
    "default_locale": "en",
    "homepage_url": "https://github.com/pinguarmy/ai-chat-exporter#readme",
    "permissions": [
      "storage",
      "activeTab",
      "downloads",
      "alarms"
    ],
    "optional_permissions": [
      "unlimitedStorage"
    ],
    "host_permissions": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://deepseek.com/*",
      "https://chat.deepseek.com/*",
      "https://gemini.google.com/*",
      "https://grok.com/*",
      "https://www.grok.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "ai-chat-exporter@pinguarmy.github.io",
        "strict_min_version": "140.0"
      }
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  }
}
